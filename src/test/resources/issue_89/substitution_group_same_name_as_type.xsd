<?xml version="1.0" encoding="UTF-8"?>
<xs:schema
    targetNamespace="https://github.com/xmlet/XsdParser/issues/89"
    elementFormDefault="qualified"
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns="https://github.com/xmlet/XsdParser/issues/89">

    <!-- A local element with the head's name, which the substitutionGroup must not resolve to. -->
    <xs:complexType name="Wrapper">
        <xs:sequence>
            <xs:element name="Head" type="xs:string"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="Head">
        <xs:sequence>
            <xs:element name="Z" type="xs:integer"/>
        </xs:sequence>
    </xs:complexType>

    <xs:element name="Head" type="Head"/>

    <xs:element name="Member" type="Head" substitutionGroup="Head"/>

</xs:schema>
