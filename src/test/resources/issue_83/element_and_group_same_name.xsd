<?xml version="1.0" encoding="UTF-8"?>
<xs:schema
    targetNamespace="https://github.com/xmlet/XsdParser/issues/83"
    elementFormDefault="qualified"
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns="https://github.com/xmlet/XsdParser/issues/83">

    <xs:group name="ModeProfile">
        <xs:annotation>
            <xs:documentation>group</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="D_MAMODE" type="xs:integer"/>
        </xs:sequence>
    </xs:group>

    <xs:element name="ModeProfile">
        <xs:annotation>
            <xs:documentation>element</xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:sequence>
                <xs:element name="Q_MAMODE" type="xs:integer"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:complexType name="ErtmsSignalType">
        <xs:sequence>
            <xs:element ref="ModeProfile" minOccurs="0"/>
            <xs:group ref="ModeProfile"/>
        </xs:sequence>
    </xs:complexType>

</xs:schema>
